{
  "type": "tabs",
  "i18n": true,
  "items": {
    "tab_general": {
      "type": "tab",
      "label": "Allgemein",
      "items": {
        "targetInstance": {
          "type": "instanceSelect",
          "adapter": "nulleinspeisung",
          "label": "Nulleinspeisung-Instanz",
          "help": "Welche Instanz soll der Agent beobachten und tunen?",
          "sm": 12,
          "md": 6,
          "default": "nulleinspeisung.0"
        },
        "divider1": { "type": "divider" },
        "Aktiv_label": {
          "type": "staticText",
          "text": "Den Hauptschalter (Aktiv) findest du als Datenpunkt nulleinspeisung-agent.0.Aktiv",
          "style": { "fontStyle": "italic", "color": "#888" }
        },
        "divider2": { "type": "divider" },
        "observeIntervalS": {
          "type": "number",
          "label": "Beobachtungsintervall (s)",
          "help": "Wie oft werden Messwerte eingelesen (Sekunden)?",
          "min": 10,
          "max": 300,
          "step": 5,
          "default": 60,
          "sm": 12,
          "md": 4
        },
        "tuneIntervalS": {
          "type": "number",
          "label": "Tuning-Intervall (s)",
          "help": "Wie oft prueft der Agent ob eine Parameteranpassung noetig ist?",
          "min": 60,
          "max": 3600,
          "step": 60,
          "default": 300,
          "sm": 12,
          "md": 4
        },
        "gridImportThresholdWh": {
          "type": "number",
          "label": "Netzbezugs-Schwelle (Wh)",
          "help": "Ab wieviel Wh akkumuliertem Netzbezug wird optimiert?",
          "min": 1,
          "max": 100,
          "step": 1,
          "default": 5,
          "sm": 12,
          "md": 4
        },
        "dryRun": {
          "type": "checkbox",
          "label": "Trockenlauf (nur protokollieren, keine Werte schreiben)",
          "default": false,
          "sm": 12
        }
      }
    },
    "tab_params": {
      "type": "tab",
      "label": "Erlaubte Parameter",
      "items": {
        "info_text": {
          "type": "staticText",
          "text": "Welche Parameter darf der Agent autonom veraendern? Nur aktivierte Parameter werden angefasst.",
          "style": { "marginBottom": "16px" }
        },
        "allowed_deadBandWatts": {
          "type": "checkbox",
          "label": "deadBandWatts — Totband (W)",
          "help": "Bereich um 0 W in dem nicht geregelt wird",
          "attr": "allowedParams",
          "arrayIndex": 0,
          "default": true,
          "sm": 12
        },
        "allowed_regulatorIntervalMs": {
          "type": "checkbox",
          "label": "regulatorIntervalMs — Regler-Intervall (ms)",
          "help": "Wie oft laeuft der Regelkreis",
          "attr": "allowedParams",
          "arrayIndex": 1,
          "default": true,
          "sm": 12
        },
        "allowed_maxLatencyTimeoutS": {
          "type": "checkbox",
          "label": "maxLatencyTimeoutS — Latenz-Timeout (s)",
          "attr": "allowedParams",
          "arrayIndex": 2,
          "default": true,
          "sm": 12
        },
        "allowed_latencyToleranceW": {
          "type": "checkbox",
          "label": "latencyToleranceW — Latenz-Toleranz (W)",
          "attr": "allowedParams",
          "arrayIndex": 3,
          "default": true,
          "sm": 12
        },
        "allowed_feedForwardEnabled": {
          "type": "checkbox",
          "label": "feedForwardEnabled — Vorsteuerung aktiv",
          "attr": "allowedParams",
          "arrayIndex": 4,
          "default": false,
          "sm": 12
        },
        "allowed_peakDetectionThresholdW": {
          "type": "checkbox",
          "label": "peakDetectionThresholdW — Spitzen-Erkennungsschwelle (W)",
          "attr": "allowedParams",
          "arrayIndex": 5,
          "default": false,
          "sm": 12
        },
        "allowed_estimatedDutyCycle": {
          "type": "checkbox",
          "label": "estimatedDutyCycle — Geschaetzter Duty-Cycle (0-1)",
          "attr": "allowedParams",
          "arrayIndex": 6,
          "default": false,
          "sm": 12
        },
        "allowed_tactPauseTimeoutMs": {
          "type": "checkbox",
          "label": "tactPauseTimeoutMs — Takt-Pause-Timeout (ms)",
          "attr": "allowedParams",
          "arrayIndex": 7,
          "default": false,
          "sm": 12
        }
      }
    },
    "tab_llm": {
      "type": "tab",
      "label": "LLM-Fallback",
      "items": {
        "llmEnabled": {
          "type": "checkbox",
          "label": "LLM-Fallback aktivieren (Claude API)",
          "help": "Das LLM springt ein wenn der deterministische Optimizer nicht weiterkommt",
          "default": false,
          "sm": 12
        },
        "llmApiKey": {
          "type": "password",
          "label": "Anthropic API Key",
          "help": "Nur benoetigt wenn LLM-Fallback aktiv. Beginnt mit 'sk-ant-...'",
          "default": "",
          "sm": 12,
          "md": 8,
          "hidden": { "!llmEnabled": true }
        },
        "llmModel": {
          "type": "select",
          "label": "Claude-Modell",
          "default": "claude-haiku-4-5",
          "options": [
            { "value": "claude-haiku-4-5",  "label": "claude-haiku-4-5 (schnell, guenstig)" },
            { "value": "claude-sonnet-4-5", "label": "claude-sonnet-4-5 (ausgewogen)" }
          ],
          "sm": 12,
          "md": 4,
          "hidden": { "!llmEnabled": true }
        },
        "llmTriggerAfterTuneAttempts": {
          "type": "number",
          "label": "LLM nach N fehlgeschlagenen Tuning-Versuchen",
          "help": "Wieviele erfolglose deterministische Anpassungen bevor das LLM gefragt wird?",
          "min": 1,
          "max": 20,
          "step": 1,
          "default": 3,
          "sm": 12,
          "md": 4,
          "hidden": { "!llmEnabled": true }
        }
      }
    }
  }
}
